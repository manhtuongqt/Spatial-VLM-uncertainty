<?xml version="1.0"?>
<sdf version="1.7">
  <world name="ur3_pick_place">
    <physics name="baseline_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <gravity>0 0 -9.81</gravity>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-contact-system.so"
            name="ignition::gazebo::systems::Contact"/>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="key_light" type="directional">
      <pose>0 0 2 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.081 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>41</label></plugin>
    </model>

    <!-- Lab convention used by this project: +Y is "front" (the direction in
         which the wrist camera/gripper looks and reaches), and -X is the
         robot's left when it faces +Y.  The bench is extended mainly forward.
         Its top stays exactly at z=0. -->
    <model name="work_table">
      <static>true</static>
      <pose>0 0.45 -0.04 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry><box><size>1.6 2.2 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 2.2 0.08</size></box></geometry>
          <material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>40</label></plugin>
    </model>

    <model name="red_cube">
      <!-- Pick slot: left of the robot (-X) and forward (+Y). -->
      <pose>-0.34 0.18 0.03 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.08</mass><inertia><ixx>0.000048</ixx><iyy>0.000048</iyy><izz>0.000048</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.8 0.03 0.03 1</ambient><diffuse>0.95 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
      <!-- Ground-truth oracle for perception-layer validation. -->
      <plugin filename="ignition-gazebo-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>15</update_frequency>
      </plugin>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>1</label></plugin>
    </model>

    <model name="blue_cube">
      <pose>-0.34 0.10 0.025 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.03 0.10 0.8 1</ambient><diffuse>0.05 0.15 0.95 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>2</label></plugin>
    </model>

    <model name="green_cube">
      <pose>-0.34 0.40 0.025 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.03 0.65 0.08 1</ambient><diffuse>0.05 0.85 0.10 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>3</label></plugin>
    </model>

    <model name="yellow_cube">
      <pose>-0.24 0.46 0.025 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.80 0.68 0.02 1</ambient><diffuse>0.98 0.86 0.04 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>4</label></plugin>
    </model>

    <model name="orange_cube">
      <pose>-0.02 0.10 0.025 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.88 0.28 0.01 1</ambient><diffuse>1.00 0.42 0.02 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>5</label></plugin>
    </model>

    <model name="purple_cube">
      <pose>0.15 0.14 0.025 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.42 0.03 0.62 1</ambient><diffuse>0.58 0.06 0.82 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin>
    </model>

    <model name="pink_cube">
      <pose>0.18 0.28 0.025 0 0 0</pose>
      <link name="cube_link">
        <inertial><mass>0.06</mass><inertia><ixx>0.000025</ixx><iyy>0.000025</iyy><izz>0.000025</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.88 0.10 0.42 1</ambient><diffuse>1.00 0.20 0.58 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>7</label></plugin>
    </model>

    <!-- Selected CC BY 4.0 meshes from ai-habitat/ycb.  Visual origins are
         re-centered here; lightweight primitive collisions keep Gazebo fast. -->
    <model name="ycb_cracker_box">
      <pose>-0.50 0.10 0.106710 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.18</mass><inertia><ixx>0.00108</ixx><iyy>0.00076</iyy><izz>0.00048</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.071720 0.163986 0.213421</size></box></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
        <visual name="ycb_visual"><pose>0.012893 0.014149 -0.103525 0 0 0</pose><geometry><mesh><uri>../models/ycb/003_cracker_box/003_cracker_box.obj</uri></mesh></geometry></visual>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>false</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><static_publisher>false</static_publisher><update_frequency>15</update_frequency></plugin>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>21</label></plugin>
    </model>

    <model name="ycb_sugar_box">
      <pose>-0.50 0.34 0.088107 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.15</mass><inertia><ixx>0.00050</ixx><iyy>0.00042</iyy><izz>0.00014</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.049450 0.093374 0.176214</size></box></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
        <visual name="ycb_visual"><pose>0.007099 0.016887 -0.088023 0 0 0</pose><geometry><mesh><uri>../models/ycb/004_sugar_box/004_sugar_box.obj</uri></mesh></geometry></visual>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>false</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><static_publisher>false</static_publisher><update_frequency>15</update_frequency></plugin>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>22</label></plugin>
    </model>

    <model name="ycb_tomato_soup_can">
      <pose>0.38 0.10 0.050948 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.12</mass><inertia><ixx>0.00013</ixx><iyy>0.00013</iyy><izz>0.00014</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.03395</radius><length>0.101895</length></cylinder></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
        <visual name="ycb_visual"><pose>0.009150 -0.084021 -0.050990 0 0 0</pose><geometry><mesh><uri>../models/ycb/005_tomato_soup_can/005_tomato_soup_can.obj</uri></mesh></geometry></visual>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>false</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><static_publisher>false</static_publisher><update_frequency>15</update_frequency></plugin>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>23</label></plugin>
    </model>

    <model name="ycb_mustard_bottle">
      <!-- Default target is isolated inside the calibrated wrist-camera workspace. -->
      <pose>-0.165 0.18 0.095695 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.18</mass><inertia><ixx>0.00061</ixx><iyy>0.00069</iyy><izz>0.00021</izz></inertia></inertial>
        <!-- The main bottle body is approximated by a graspable cylinder;
             DINO/RGB-D still observes the full original visual geometry. -->
        <collision name="collision"><geometry><cylinder><radius>0.030</radius><length>0.185</length></cylinder></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
        <visual name="ycb_visual"><pose>0.015323 0.023535 -0.092468 0 0 0</pose><geometry><mesh><uri>../models/ycb/006_mustard_bottle/006_mustard_bottle.obj</uri></mesh></geometry></visual>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>false</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><static_publisher>false</static_publisher><update_frequency>15</update_frequency></plugin>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>24</label></plugin>
    </model>

    <model name="ycb_banana">
      <pose>-0.48 0.58 0.018376 0 0 0.25</pose>
      <link name="object_link">
        <inertial><mass>0.12</mass><inertia><ixx>0.00033</ixx><iyy>0.00013</iyy><izz>0.00044</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.108971 0.178395 0.036752</size></box></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
        <visual name="ycb_visual"><pose>-0.011491 0.007339 -0.017956 0 0 0</pose><geometry><mesh><uri>../models/ycb/011_banana/011_banana.obj</uri></mesh></geometry></visual>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>false</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><static_publisher>false</static_publisher><update_frequency>15</update_frequency></plugin>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>25</label></plugin>
    </model>

    <model name="ycb_apple">
      <pose>-0.32 0.50 0.035953 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.12</mass><inertia><ixx>0.00007</ixx><iyy>0.00007</iyy><izz>0.00007</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.03771</radius></sphere></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
        <visual name="ycb_visual"><pose>-0.000863 0.003786 -0.035541 0 0 0</pose><geometry><mesh><uri>../models/ycb/013_apple/013_apple.obj</uri></mesh></geometry></visual>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>false</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><static_publisher>false</static_publisher><update_frequency>15</update_frequency></plugin>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>26</label></plugin>
    </model>

    <model name="ycb_orange">
      <!-- Reset at the collision-sphere support height.  The old mesh-derived
           z=0.035684 penetrated the table by 1.3 mm and injected a rolling
           impulse as soon as physics resumed. -->
      <pose>0.28 0.18 0.037010 0 0 0</pose>
      <link name="object_link">
        <inertial><mass>0.13</mass><inertia><ixx>0.00007</ixx><iyy>0.00007</iyy><izz>0.00007</izz></inertia></inertial>
        <!-- A real orange has rolling resistance from its non-perfect skin.
             Angular decay prevents an ideal mathematical sphere from rolling
             indefinitely while retaining ordinary contact physics. -->
        <velocity_decay><linear>0.25</linear><angular>0.80</angular></velocity_decay>
        <collision name="collision"><geometry><sphere><radius>0.03701</radius></sphere></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
        <visual name="ycb_visual"><pose>0.006944 0.018358 -0.035408 0 0 0</pose><geometry><mesh><uri>../models/ycb/017_orange/017_orange.obj</uri></mesh></geometry></visual>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>false</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><static_publisher>false</static_publisher><update_frequency>15</update_frequency></plugin>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>27</label></plugin>
    </model>

    <model name="ycb_power_drill">
      <pose>0.36 0.57 0.028689 0 0 -0.25</pose>
      <link name="object_link">
        <inertial><mass>0.45</mass><inertia><ixx>0.00137</ixx><iyy>0.00139</iyy><izz>0.00258</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.183995 0.187244 0.057377</size></box></geometry><surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
        <visual name="ycb_visual"><pose>0.045866 -0.010493 -0.025266 0 0 0</pose><geometry><mesh><uri>../models/ycb/035_power_drill/035_power_drill.obj</uri></mesh></geometry></visual>
      </link>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>false</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><static_publisher>false</static_publisher><update_frequency>15</update_frequency></plugin>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>28</label></plugin>
    </model>

    <model name="mango">
      <pose>-0.50 0.75 0.030 0 0 0.35</pose>
      <link name="mango_link">
        <inertial><mass>0.16</mass><inertia><ixx>0.000060</ixx><iyy>0.000060</iyy><izz>0.000060</izz></inertia></inertial>
        <collision name="fruit_collision"><geometry><sphere><radius>0.030</radius></sphere></geometry></collision>
        <visual name="mango_body"><geometry><sphere><radius>0.030</radius></sphere></geometry><material><ambient>0.92 0.38 0.01 1</ambient><diffuse>1.0 0.58 0.03 1</diffuse></material></visual>
        <visual name="mango_lobe"><pose>-0.019 0 0.004 0 0 0</pose><geometry><sphere><radius>0.021</radius></sphere></geometry><material><ambient>0.74 0.25 0.01 1</ambient><diffuse>0.95 0.43 0.02 1</diffuse></material></visual>
        <visual name="mango_tip"><pose>0.021 0 -0.005 0 0 0</pose><geometry><sphere><radius>0.014</radius></sphere></geometry><material><ambient>0.96 0.56 0.03 1</ambient><diffuse>1.0 0.67 0.05 1</diffuse></material></visual>
        <visual name="mango_leaf"><pose>-0.006 0 0.032 0 0.45 0</pose><geometry><sphere><radius>0.007</radius></sphere></geometry><material><ambient>0.05 0.40 0.04 1</ambient><diffuse>0.07 0.65 0.07 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>29</label></plugin>
    </model>



    <!-- The tray is directly in front of the robot according to the same +Y
         convention, centered on the robot's forward axis. -->
    <model name="target_bin">
      <static>true</static>
      <pose>0 0.38 0 0 0 0</pose>
      <link name="bin_link">
        <collision name="floor_collision"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.20 0.25 0.01</size></box></geometry></collision>
        <visual name="floor_visual"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.20 0.25 0.01</size></box></geometry><material><ambient>0.85 0.45 0.02 1</ambient><diffuse>0.95 0.55 0.03 1</diffuse></material></visual>
        <collision name="front_collision"><pose>0.095 0 0.035 0 0 0</pose><geometry><box><size>0.01 0.25 0.07</size></box></geometry></collision>
        <visual name="front_visual"><pose>0.095 0 0.035 0 0 0</pose><geometry><box><size>0.01 0.25 0.07</size></box></geometry><material><ambient>0.85 0.45 0.02 1</ambient></material></visual>
        <collision name="back_collision"><pose>-0.095 0 0.035 0 0 0</pose><geometry><box><size>0.01 0.25 0.07</size></box></geometry></collision>
        <visual name="back_visual"><pose>-0.095 0 0.035 0 0 0</pose><geometry><box><size>0.01 0.25 0.07</size></box></geometry><material><ambient>0.85 0.45 0.02 1</ambient></material></visual>
        <collision name="left_collision"><pose>0 0.12 0.035 0 0 0</pose><geometry><box><size>0.20 0.01 0.07</size></box></geometry></collision>
        <visual name="left_visual"><pose>0 0.12 0.035 0 0 0</pose><geometry><box><size>0.20 0.01 0.07</size></box></geometry><material><ambient>0.85 0.45 0.02 1</ambient></material></visual>
        <collision name="right_collision"><pose>0 -0.12 0.035 0 0 0</pose><geometry><box><size>0.20 0.01 0.07</size></box></geometry></collision>
        <visual name="right_visual"><pose>0 -0.12 0.035 0 0 0</pose><geometry><box><size>0.20 0.01 0.07</size></box></geometry><material><ambient>0.85 0.45 0.02 1</ambient></material></visual>
      </link>
