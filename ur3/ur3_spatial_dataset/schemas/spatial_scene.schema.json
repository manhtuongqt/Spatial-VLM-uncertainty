{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uet.local/ur3/spatial_scene.schema.json",
  "title": "UR3 canonical spatial scene",
  "type": "object",
  "required": ["schema_version", "scene_id", "frame_id", "view_pose_id", "objects", "relations"],
  "properties": {
    "schema_version": {"const": 1},
    "scene_id": {"type": "string", "pattern": "^scene_[0-9]{4,}$"},
    "frame_id": {"const": "base_link"},
    "view_pose_id": {"type": "string"},
    "view_transform_frozen": {"type": "boolean"},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "pose", "dimensions", "pose_source"],
        "properties": {
          "id": {"type": "string"},
          "category": {"type": "string"},
          "pose": {
            "type": "object",
            "required": ["position", "orientation_xyzw"],
            "properties": {
              "position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
              "orientation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
            }
          },
          "dimensions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject_id", "predicate", "object_id", "relation_frame"],
        "properties": {
          "predicate": {"enum": ["left_of", "right_of", "above", "below", "front_of", "behind", "inside", "near"]}
        }
      }
    }
  }
}
