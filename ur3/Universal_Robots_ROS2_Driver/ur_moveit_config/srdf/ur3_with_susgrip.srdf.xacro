<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <!-- robot name parameter -->
  <xacro:arg name="name" default="ur"/>
  <!-- parameters -->
  <xacro:arg name="prefix" default="" />

  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>

  <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>

  <!-- Gripper planning group -->
  <group name="gripper">
    <joint name="gripper_joint" />
  </group>

  <end_effector name="susgrip_eef" parent_link="tool0" group="gripper"
                  parent_group="ur_manipulator"/>

  <!-- Disable collisions for SusGrip 2F Gripper (Simple Gazebo version) -->
  <disable_collisions link1="gripper_body" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_body" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="gripper_body" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="gripper_body" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="gripper_body" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="gripper_tcp" link2="gripper_body" reason="Adjacent"/>
  <disable_collisions link1="gripper_tcp" link2="finger_left" reason="Never"/>
  <disable_collisions link1="gripper_tcp" link2="finger_right" reason="Never"/>

  <!-- Left Finger -->
  <disable_collisions link1="finger_left" link2="gripper_body" reason="Adjacent"/>
  <disable_collisions link1="finger_left" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="finger_left" link2="tool0" reason="Never"/>
  <disable_collisions link1="finger_left" link2="flange" reason="Never"/>
  <disable_collisions link1="finger_left" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="finger_left" link2="wrist_1_link" reason="Never"/>

  <!-- Right Finger -->
  <disable_collisions link1="finger_right" link2="gripper_body" reason="Adjacent"/>
  <disable_collisions link1="finger_right" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="finger_right" link2="tool0" reason="Never"/>
  <disable_collisions link1="finger_right" link2="flange" reason="Never"/>
  <disable_collisions link1="finger_right" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="finger_right" link2="wrist_1_link" reason="Never"/>

  <!-- Fingers with each other -->
  <disable_collisions link1="finger_left" link2="finger_right" reason="Never"/>

  <!-- Camera Link -->
  <disable_collisions link1="camera_link" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="gripper_body" reason="Never"/>
  <disable_collisions link1="camera_link" link2="finger_left" reason="Never"/>
  <disable_collisions link1="camera_link" link2="finger_right" reason="Never"/>

  <!-- Spacer Cylinder -->
  <disable_collisions link1="spacer_cylinder" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="spacer_cylinder" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="spacer_cylinder" link2="gripper_body" reason="Adjacent"/>
  <disable_collisions link1="spacer_cylinder" link2="finger_left" reason="Never"/>
  <disable_collisions link1="spacer_cylinder" link2="finger_right" reason="Never"/>
  <disable_collisions link1="spacer_cylinder" link2="camera_link" reason="Never"/>

</robot>
