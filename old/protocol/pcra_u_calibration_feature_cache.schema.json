{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pcra_u_calibration_feature_cache.schema.json",
  "title": "Oracle-free pooled P-CRA-U calibration feature cache index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "scope",
    "status",
    "created_at_utc",
    "model_inventory_sha256",
    "feature_manifest_sha256",
    "pooling_contract_sha256",
    "features",
    "sample_to_feature",
    "counts",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"const": "pcra_u_calibration_v1"},
    "scope": {"const": "full"},
    "status": {"const": "COMPLETE"},
    "created_at_utc": {"type": "string"},
    "model_inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "feature_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pooling_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "rgb_sha256",
          "depth_sha256",
          "tensor_shapes",
          "dtype",
          "observable_input_summary"
        ],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "rgb_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "depth_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "tensor_shapes": {
            "type": "object",
            "const": {
              "R0_GRID": [24, 32, 1152],
              "D0_GRID": [24, 32, 1152],
              "R0_THUMB": [1152],
              "D0_THUMB": [1152]
            }
          },
          "dtype": {"const": "torch.float16"},
          "observable_input_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zero_valued_depth_input_fraction", "definition"],
            "properties": {
              "zero_valued_depth_input_fraction": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "definition": {
                "const": "fraction_of_640x480_depth_model_input_pixels_with_all_channels_zero"
              }
            }
          }
        }
      }
    },
    "sample_to_feature": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "unique_feature_pairs", "newly_extracted", "reused_verified"],
      "properties": {
        "samples": {"const": 1000},
        "unique_feature_pairs": {"type": "integer", "minimum": 1, "maximum": 1000},
        "newly_extracted": {"type": "integer", "minimum": 0},
        "reused_verified": {"type": "integer", "minimum": 0}
      }
    },
    "runtime": {"type": "object"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_manifest_only",
        "evaluator_artifacts_read",
        "model_training_performed",
        "oracle_labels_cached",
        "test_opened",
        "baseline_modified"
      ],
      "properties": {
        "inference_manifest_only": {"const": true},
        "evaluator_artifacts_read": {"const": false},
        "model_training_performed": {"const": false},
        "oracle_labels_cached": {"const": false},
        "test_opened": {"const": false},
        "baseline_modified": {"const": false}
      }
    }
  }
}
