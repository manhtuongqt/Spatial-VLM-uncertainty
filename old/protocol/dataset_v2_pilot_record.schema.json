{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.roborefer/protocol/dataset_v2_pilot_record.schema.json",
  "title": "RoboRefer Dataset V2 pilot-only sample record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_id", "sample_id", "family_id", "split",
    "variant", "family_category", "ood_axis", "depth_dependent", "instruction",
    "inference_payload", "sensor_evidence", "evaluator_only", "provenance",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"const": "roborefer_dataset_v2_pilot_only"},
    "sample_id": {"type": "string", "pattern": "^v2pilot_family_[0-9]{6}__[a-z_]+$"},
    "family_id": {"type": "string", "pattern": "^v2pilot_family_[0-9]{6}$"},
    "split": {"const": "pilot_only"},
    "variant": {"enum": ["clean", "semantic_counterfactual", "relation_counterfactual", "depth_corruption", "occlusion_view_counterfactual"]},
    "family_category": {"enum": ["direct_grounding", "relation_2d", "nearer_farther", "front_behind_camera", "multi_anchor_depth_order", "occlusion_depth_evidence"]},
    "ood_axis": {"enum": ["none", "asset", "layout", "viewpoint", "language", "depth_noise"]},
    "depth_dependent": {"type": "boolean"},
    "instruction": {"type": "string", "minLength": 12},
    "inference_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["rgb_model_input", "depth_relative_model_input", "enable_depth", "prompt", "coordinate_suffix"],
      "properties": {
        "rgb_model_input": {"$ref": "#/$defs/fileRef"},
        "depth_relative_model_input": {"$ref": "#/$defs/fileRef"},
        "enable_depth": {"const": true},
        "prompt": {"type": "string"},
        "coordinate_suffix": {"type": "string"}
      }
    },
    "sensor_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["rgb_original", "depth_metric", "depth_relative_clean", "camera_info", "tf_snapshot", "registered_rgb_depth_labels", "capture_timestamps"],
      "properties": {
        "rgb_original": {"$ref": "#/$defs/fileRef"},
        "depth_metric": {"$ref": "#/$defs/fileRef"},
        "depth_relative_clean": {"$ref": "#/$defs/fileRef"},
        "camera_info": {"$ref": "#/$defs/fileRef"},
        "tf_snapshot": {"$ref": "#/$defs/fileRef"},
        "registered_rgb_depth_labels": {"const": true},
        "capture_timestamps": {
          "type": "object", "additionalProperties": false,
          "required": ["rgb_sec", "depth_sec", "labels_sec", "max_spread_sec"],
          "properties": {
            "rgb_sec": {"type": "number"}, "depth_sec": {"type": "number"},
            "labels_sec": {"type": "number"},
            "max_spread_sec": {"type": "number", "minimum": 0, "maximum": 0.035}
          }
        }
      }
    },
    "evaluator_only": {
      "type": "object", "additionalProperties": false,
      "required": ["access_policy", "semantic_instance_labels", "masks", "spatial_label", "uncertainty_label", "object_oracle"],
      "properties": {
        "access_policy": {"const": "never_export_to_inference_payload"},
        "semantic_instance_labels": {"$ref": "#/$defs/fileRef"},
        "masks": {
          "type": "object", "additionalProperties": false,
          "required": ["target", "target_interior", "anchor", "graspable", "reachable", "valid_depth"],
          "properties": {
            "target": {"$ref": "#/$defs/fileRef"},
            "target_interior": {"$ref": "#/$defs/fileRef"},
            "anchor": {"type": "array", "items": {"$ref": "#/$defs/namedMask"}},
            "graspable": {"$ref": "#/$defs/fileRef"},
            "reachable": {"$ref": "#/$defs/fileRef"},
            "valid_depth": {"$ref": "#/$defs/fileRef"}
          }
        },
        "spatial_label": {
          "type": "object", "additionalProperties": false,
          "required": ["candidate_target_ids", "anchor_ids", "valid_target_ids", "relations", "relation_graph", "reference_frame"],
          "properties": {
            "candidate_target_ids": {"type": "array", "items": {"type": "string"}},
            "anchor_ids": {"type": "array", "items": {"type": "string"}},
            "valid_target_ids": {"type": "array", "items": {"type": "string"}},
            "relations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "relation_graph": {"type": "array", "items": {"type": "object"}},
            "reference_frame": {"enum": ["camera_color_optical_frame", "image", "base_link", "object_semantics"]}
          }
        },
        "uncertainty_label": {
          "type": "object", "additionalProperties": false,
          "required": ["answerable", "state", "state_submode", "sources", "severity", "expected_intervention"],
          "properties": {
            "answerable": {"type": "boolean"},
            "state": {"enum": ["FOUND", "AMBIGUOUS", "ABSENT", "INSUFFICIENT_EVIDENCE"]},
            "state_submode": {"type": "string", "minLength": 3},
            "sources": {"type": "array", "items": {"enum": ["semantic", "relation", "spatial", "depth", "calibration", "occlusion", "action"]}},
            "severity": {"type": "integer", "minimum": 0, "maximum": 3},
            "expected_intervention": {"enum": ["EXECUTE", "REOBSERVE", "REPROMPT", "ASK_USER", "ABSTAIN"]}
          }
        },
        "object_oracle": {
          "type": "object", "additionalProperties": false,
          "required": ["requested_layout_base_link", "active_scene_ids", "label_ids", "reachability_label_policy"],
          "properties": {
            "requested_layout_base_link": {"type": "object"},
            "active_scene_ids": {"type": "array", "items": {"type": "string"}},
            "label_ids": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 255}},
            "reachability_label_policy": {"type": "string"}
          }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["seed_bundle", "generator_version", "capture_id", "capture_backend", "perturbation", "pilot_exclusion_policy", "code_config_checkpoint_sha256"],
      "properties": {
        "seed_bundle": {"type": "object", "additionalProperties": {"type": "integer"}},
        "generator_version": {"type": "string"},
        "capture_id": {"type": "string", "pattern": "^v2pilot_family_[0-9]{6}__(clean|occlusion)_capture$"},
        "capture_backend": {"const": "Gazebo Fortress RGB-D + semantic segmentation"},
        "perturbation": {"type": "object"},
        "pilot_exclusion_policy": {"const": "NEVER_REUSE_ID_SEED_CAPTURE_LAYOUT_OR_SAMPLE_IN_OFFICIAL_DATASET"},
        "code_config_checkpoint_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "artifact_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  },
  "$defs": {
    "fileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "namedMask": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "path", "sha256", "bytes"],
      "properties": {
        "object_id": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
