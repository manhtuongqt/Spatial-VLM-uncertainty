{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roborefer.local/schemas/feature_cache_v1.schema.json",
  "title": "WP3 RoboRefer pre-projector feature cache record v1",
  "description": "Oracle-free cache metadata for frozen RoboRefer RGB/depth features. Evaluator masks, object identities, graph labels, uncertainty labels, interventions, correctness and robot poses are intentionally not representable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "cache_id",
    "run_id",
    "sample_id",
    "family_id",
    "split",
    "variant",
    "input",
    "model",
    "features",
    "tiling",
    "baseline_prediction",
    "runtime",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_id": {
      "const": "wp3_feature_hook_smoke_v1"
    },
    "cache_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "enum": [
        "hook_a",
        "hook_b"
      ]
    },
    "sample_id": {
      "type": "string",
      "pattern": "^wp2_family_[0-9]{4}__[a-z0-9_]+$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^wp2_family_[0-9]{4}$"
    },
    "split": {
      "const": "train"
    },
    "variant": {
      "type": "string",
      "enum": [
        "clean",
        "semantic_counterfactual",
        "relation_counterfactual",
        "depth_corruption",
        "occlusion_view_counterfactual"
      ]
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "features": {
      "$ref": "#/$defs/features"
    },
    "tiling": {
      "$ref": "#/$defs/tiling"
    },
    "baseline_prediction": {
      "$ref": "#/$defs/baselinePrediction"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))"
      }
    },
    "shape": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 13
        },
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false
    },
    "xyxy": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rgb_sha256",
        "depth_sha256",
        "instruction_sha256",
        "request_sha256"
      ],
      "properties": {
        "rgb_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "depth_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "instruction_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_inventory_sha256",
        "root_config_sha256",
        "feature_contract_sha256",
        "feature_gate_lock_sha256",
        "loader_runtime_dtype",
        "checkpoint_declared_dtype",
        "code_hashes"
      ],
      "properties": {
        "checkpoint_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "root_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "feature_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "feature_gate_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "loader_runtime_dtype": {
          "type": "string",
          "enum": [
            "torch.float16",
            "torch.bfloat16"
          ]
        },
        "checkpoint_declared_dtype": {
          "const": "bfloat16"
        },
        "code_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_./-]+$"
          }
        }
      }
    },
    "featureTensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "file_sha256",
        "tensor_key",
        "shape",
        "dtype",
        "device_at_extraction",
        "stage",
        "patch_grid_height",
        "patch_grid_width"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/relativePath"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tensor_key": {
          "type": "string",
          "enum": [
            "R0",
            "D0"
          ]
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "dtype": {
          "type": "string",
          "enum": [
            "torch.float16",
            "torch.bfloat16"
          ]
        },
        "device_at_extraction": {
          "type": "string",
          "pattern": "^(?:cuda:[0-9]+|cpu)$"
        },
        "stage": {
          "const": "tower_output_before_projector"
        },
        "patch_grid_height": {
          "const": 32
        },
        "patch_grid_width": {
          "const": 32
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_format",
        "shared_file",
        "r0",
        "d0",
        "projected_rgb_shape",
        "projected_depth_shape"
      ],
      "properties": {
        "storage_format": {
          "const": "safetensors"
        },
        "shared_file": {
          "const": true
        },
        "r0": {
          "$ref": "#/$defs/featureTensor"
        },
        "d0": {
          "$ref": "#/$defs/featureTensor"
        },
        "projected_rgb_shape": {
          "$ref": "#/$defs/shape"
        },
        "projected_depth_shape": {
          "$ref": "#/$defs/shape"
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tile_index",
        "tile_kind",
        "resized_canvas_xyxy",
        "original_image_xyxy",
        "patch_grid_height",
        "patch_grid_width"
      ],
      "properties": {
        "tile_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "tile_kind": {
          "type": "string",
          "enum": [
            "local",
            "thumbnail"
          ]
        },
        "resized_canvas_xyxy": {
          "$ref": "#/$defs/xyxy"
        },
        "original_image_xyxy": {
          "$ref": "#/$defs/xyxy"
        },
        "patch_grid_height": {
          "const": 32
        },
        "patch_grid_width": {
          "const": 32
        }
      }
    },
    "tiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_width",
        "original_height",
        "tile_size",
        "grid_columns",
        "grid_rows",
        "local_tile_count",
        "thumbnail_present",
        "resized_canvas_width",
        "resized_canvas_height",
        "rgb_depth_aligned",
        "tile_order",
        "tiles"
      ],
      "properties": {
        "original_width": {
          "type": "integer",
          "minimum": 1
        },
        "original_height": {
          "type": "integer",
          "minimum": 1
        },
        "tile_size": {
          "const": 448
        },
        "grid_columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "grid_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "local_tile_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "thumbnail_present": {
          "type": "boolean"
        },
        "resized_canvas_width": {
          "type": "integer",
          "minimum": 448
        },
        "resized_canvas_height": {
          "type": "integer",
          "minimum": 448
        },
        "rgb_depth_aligned": {
          "const": true
        },
        "tile_order": {
          "const": "row_major_local_then_thumbnail"
        },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "items": {
            "$ref": "#/$defs/tile"
          }
        }
      }
    },
    "baselinePrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_answer",
        "raw_answer_sha256",
        "parse_status",
        "normalized_points_xy"
      ],
      "properties": {
        "raw_answer": {
          "type": "string"
        },
        "raw_answer_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parse_status": {
          "type": "string",
          "enum": [
            "EXACT_ONE_NORMALIZED_POINT",
            "FORMAT_VIOLATION",
            "NO_POINT",
            "MULTIPLE_OR_INVALID_POINTS",
            "OUT_OF_RANGE"
          ]
        },
        "normalized_points_xy": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ],
            "items": false
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preprocess_latency_ms",
        "feature_latency_ms",
        "generation_latency_ms",
        "total_latency_ms",
        "peak_vram_bytes",
        "gpu_name",
        "torch_version",
        "cuda_version",
        "cublas_workspace_config"
      ],
      "properties": {
        "preprocess_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "feature_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "generation_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "total_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "peak_vram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "gpu_name": {
          "type": "string",
          "minLength": 1
        },
        "torch_version": {
          "type": "string",
          "minLength": 1
        },
        "cuda_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "cublas_workspace_config": {
          "const": ":4096:8"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_manifest_only",
        "evaluator_artifacts_read",
        "training_performed",
        "dataset_scaled",
        "robot_target_published"
      ],
      "properties": {
        "inference_manifest_only": {
          "const": true
        },
        "evaluator_artifacts_read": {
          "const": false
        },
        "training_performed": {
          "const": false
        },
        "dataset_scaled": {
          "const": false
        },
        "robot_target_published": {
          "const": false
        }
      }
    }
  }
}
